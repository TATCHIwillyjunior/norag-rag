# Required: Google Gemini API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: Default LLM model for answer generation (defaults to gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# Optional: Concept graph LLM extraction overrides (defaults to GOOGLE_API_KEY and LLM_MODEL)
# GRAPH_API_KEY=
# GRAPH_MODEL=gemini-2.5-flash
# GRAPH_HOPS=3

# Optional: price in USD of one million tokens, used for the cost shown in the traces
PRICE_INPUT_PER_M=0.075
PRICE_OUTPUT_PER_M=0.30

# Optional: traces older than this many days are deleted (default 30)
TRACE_RETENTION_DAYS=30
